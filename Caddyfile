# Caddyfile de Railpack para Railway, sin su Content-Security-Policy: el visor 3D carga
# las texturas de los modelos GLB desde URLs blob: y esa política las bloquea (connect-src).
# GitHub Pages tampoco envía CSP. Plantilla original:
# https://github.com/railwayapp/railpack/blob/main/core/providers/staticfile/Caddyfile.template

{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	# Security headers
	header {
		# Enable cross-site filter (XSS) and tell browsers to block detected attacks
		X-XSS-Protection "1; mode=block"
		# Prevent some browsers from MIME-sniffing a response away from the declared Content-Type
		X-Content-Type-Options "nosniff"
		# Keep referrer data off of HTTP connections
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove Server header
		-Server
	}

	root * {{.StaticFileRoot}}

	# Handle static files
	file_server {
		hide .git
		hide .env*
	}

	# Compression with more formats
	encode {
		gzip
		zstd
	}

	# Try files with HTML extension{{if .IndexFallback}} and handle SPA routing{{end}}
	try_files {path} {path}.html {path}/index.html{{if .IndexFallback}} /index.html{{end}}

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
