# Copie este archivo como admin/.env para trabajar en local. NUNCA suba el .env (ni un .env.*) al repositorio.
# En Railway no hay .env: estas variables se definen en el servicio del panel (Variables).
# Formato: CLAVE=valor; cada comentario en su propia línea, empezando con #. Si la clave lleva espacios o #,
# póngala entre comillas.

# Usuario y clave del administrador (nombres exactos de las variables)
ADMIN=
password=

# Conexión a MongoDB. En Railway es obligatoria (sin ella el panel no arranca): use la referencia
# ${{MongoDB.MONGO_URL}} del plugin MongoDB o la URI de Atlas. En local, sin ella se usa mongodb://127.0.0.1:27017.
MONGODB_URI=mongodb://127.0.0.1:27017
# Opcional: nombre de la base de datos si la URI no lo trae (por defecto panel_yondo)
MONGODB_DB=

# Opcionales: quite el # del principio para usarlos
# Duración de la sesión, en horas
# SESSION_HOURS=12
# Cookie solo por HTTPS (en Railway se activa sola)
# COOKIE_SECURE=1
# Tamaño máximo de cada Excel, en MB
# MAX_UPLOAD_MB=25
