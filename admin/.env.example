# Copie este archivo como admin/.env para trabajar en local. NUNCA suba el .env al repositorio.
# En Railway estas variables se definen en el servicio del panel (Variables).

# Usuario y clave del administrador (nombres exactos de las variables)
ADMIN=
password=

# Conexión a MongoDB (plugin MongoDB de Railway: use la referencia ${{MongoDB.MONGO_URL}})
MONGODB_URI=mongodb://127.0.0.1:27017
# Opcional: nombre de la base de datos si la URI no lo trae (por defecto panel_yondo)
MONGODB_DB=

# Opcionales
# SESSION_HOURS=12      # duración de la sesión
# COOKIE_SECURE=1       # cookie solo por HTTPS (en Railway se activa sola)
# MAX_UPLOAD_MB=25      # tamaño máximo de cada Excel
