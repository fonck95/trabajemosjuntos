{
  "$schema": "https://schema.railpack.com",
  "packages": { "python": "3.12" },
  "steps": {
    "build": {
      "commands": [
        "...",
        "python3 scripts/build_data.py",
        "PANEL_URL=${PANEL_URL:-/panel/} python3 scripts/build_site.py"
      ]
    }
  },
  "deploy": {
    "startCommand": "uvicorn servidor:app --app-dir admin --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips=* --no-access-log --no-server-header"
  }
}
